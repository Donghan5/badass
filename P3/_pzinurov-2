#!/bin/sh
# ===========================================================================
#  P3 / _pzinurov-2      image: badass/router        ROLE: LEAF / VTEP
# ---------------------------------------------------------------------------
#      _pzinurov-1 (RR) e0 ----- eth0  _pzinurov-2  eth1 ----- host_pzinurov-1
#                        10.1.1.0/30            lo 1.1.1.2
#
#  A leaf does two jobs at once:
#
#   1. underlay (pure IP)    : OSPF area 0 on eth0 and on the /32 loopback,
#                              so that 1.1.1.1 .. 1.1.1.4 are reachable.
#   2. overlay  (VXLAN+EVPN) : br0 + vxlan10, and bgpd advertises in EVPN
#                              every MAC that br0 learns on its access port.
#
#  Key detail: the tunnel is created with "nolearning".  In part 2 the bridge
#  learned remote MACs from the data plane (flood and learn).  Here we forbid
#  that on purpose: remote MACs must come from BGP, as EVPN route type 2.
#  "advertise-all-vni" tells bgpd to export every VNI zebra finds locally,
#  which also produces the EVPN route type 3 (inclusive multicast) used to
#  build the BUM flooding list - that is why no multicast group is needed
#  anymore, unlike part 2.
#
#  The VTEP source address is the LOOPBACK (1.1.1.2), not the interface address:
#  the tunnel then survives any underlay topology change as long as OSPF can
#  still reach the loopback.
# ===========================================================================
set -e

. /badass/lab/env.sh 2>/dev/null || { VNI=10; VXDEV=vxlan10; BRIDGE=br0; VXPORT=4789; }

LOOPBACK=1.1.1.2
ACCESS_IF=eth1                 # port facing host_pzinurov-1

# ---------------------------------------------------------------------------
# 1. routing engines: addressing + OSPF underlay + iBGP/EVPN to the RR
# ---------------------------------------------------------------------------
cat > /etc/frr/frr.conf <<'FRR'
frr version 10.0
frr defaults traditional
hostname _pzinurov-2
service integrated-vtysh-config
!
ip forwarding
!
interface lo
 ip address 1.1.1.2/32
exit
!
interface eth0
 description p2p -> _pzinurov-1 (RR)
 ip address 10.1.1.2/30
 ip ospf network point-to-point
exit
!
router ospf
 ospf router-id 1.1.1.2
 network 1.1.1.2/32 area 0
 network 10.1.1.0/30 area 0
exit
!
router bgp 1
 bgp router-id 1.1.1.2
 bgp log-neighbor-changes
 no bgp default ipv4-unicast
 !
 neighbor 1.1.1.1 remote-as 1
 neighbor 1.1.1.1 update-source lo
 neighbor 1.1.1.1 description _pzinurov-1 (route reflector)
 !
 address-family l2vpn evpn
  neighbor 1.1.1.1 activate
  ! export every locally defined VNI -> route type 3 now, type 2 as soon as
  ! a host MAC shows up on br0
  advertise-all-vni
 exit-address-family
exit
!
line vty
!
FRR
chown frr:frr /etc/frr/frr.conf; chmod 0640 /etc/frr/frr.conf

frr-start

# the vxlan interface takes its source address from the loopback, so wait
# until zebra has actually installed it before creating the tunnel
i=0
while ! ip -4 -o addr show dev lo | grep -q " $LOOPBACK/32 " && [ $i -lt 50 ]; do
    i=$((i+1)); sleep 0.2
done

# ---------------------------------------------------------------------------
# 2. data plane: the VXLAN bridge domain of VNI 10
# ---------------------------------------------------------------------------
ip link del "$BRIDGE" 2>/dev/null || true
ip link add "$BRIDGE" type bridge
ip link set "$BRIDGE" up

ip link del "$VXDEV" 2>/dev/null || true
ip link add "$VXDEV" type vxlan \
        id "$VNI" \
        local "$LOOPBACK" \
        dstport "$VXPORT" \
        nolearning              # remote MACs come from BGP EVPN, not flooding
ip link set "$VXDEV" master "$BRIDGE"
ip link set "$VXDEV" up

# access port: untagged, towards host_pzinurov-1
ip addr flush dev "$ACCESS_IF" 2>/dev/null || true
ip link set "$ACCESS_IF" master "$BRIDGE"
ip link set "$ACCESS_IF" up

# ARP suppression is left OFF so that the ARP exchange stays visible inside
# the VXLAN when you capture the link (as in the subject's screenshots):
#   bridge link set dev vxlan10 neigh_suppress on    # <- would hide it

echo "### $(hostname)  LEAF/VTEP $LOOPBACK  VNI $VNI  access $ACCESS_IF -> host_pzinurov-1"
echo "### evpn vni:" ; vtysh -c 'show evpn vni'              | sed 's/^/    /'
echo "### bgp evpn:" ; vtysh -c 'show bgp l2vpn evpn summary'| sed 's/^/    /'
